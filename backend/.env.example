# 复制本文件为 backend/.env 并填入真实值（.env 已 gitignore，不会进仓库）。
# 下方为全部可配置项；未列出的使用 src/config.py 的默认值。

# ===== LLM 对话 =====
OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL_NAME=Qwen3.6-35B
# 可选：思考模型附加参数（JSON），如 {"reasoning_effort":"high"}
# SMART_EXTRA_BODY=

# ===== Embedding / 知识库 RAG =====
# provider: api(OpenAI 兼容远程) | local(sentence-transformers 进程内本地模型)
EMBEDDING_PROVIDER=api
# --- api 模式 ---
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_BASE_URL=https://api.openai.com/v1
# --- local 模式 ---
EMBEDDING_LOCAL_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_LOCAL_DEVICE=cpu
# 国内加速下载 HuggingFace 模型（huggingface_hub 读 os.environ）
# HF_ENDPOINT=https://hf-mirror.com
RAG_TOP_K=3

# ===== 图像生成（文章封面等）=====
IMAGE_GENERATION_MODEL=gpt-image-1

# ===== 安全（必填）=====
# JWT 签名密钥：缺失或使用公开弱值时服务启动即失败。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 注册邀请码：留空关闭注册；填写后仅匹配邀请码可注册。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
REGISTRATION_INVITE_CODE=
# 用户 LLM Key 数据库加密主密钥（必填，部署后稳定保管）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SETTINGS_ENCRYPTION_KEY=

# ===== 公开聊天（匿名入口，按 IP 共享额度）=====
PUBLIC_CHAT_DAILY_IP_LIMIT=10

# ===== AI 聊天附件 =====
# 上传硬上限 10 MiB；发送时图片 5 MiB、文档 10 MiB、最多 20 个且合计 25 MiB。
CHAT_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
CHAT_ATTACHMENT_MAX_IMAGE_SIZE_BYTES=5242880
CHAT_ATTACHMENT_MAX_DOCUMENT_SIZE_BYTES=10485760
CHAT_ATTACHMENT_MAX_COUNT_PER_MESSAGE=20
CHAT_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=26214400
# 文档抽取：单文件最多 30000 字符，一条消息合计最多 80000 字符；超出明确标记截断。
CHAT_ATTACHMENT_MAX_DOCUMENT_CHARS=30000
CHAT_ATTACHMENT_MAX_TOTAL_DOCUMENT_CHARS=80000
CHAT_ATTACHMENT_PENDING_TTL_SECONDS=86400
CHAT_ATTACHMENT_CLAIM_TTL_SECONDS=7200
# 单用户 pending 草稿上限，防止持续上传占满磁盘。
CHAT_ATTACHMENT_MAX_PENDING_COUNT_PER_USER=100
CHAT_ATTACHMENT_MAX_PENDING_SIZE_BYTES_PER_USER=104857600
CHAT_ATTACHMENT_CLEANUP_BATCH_SIZE=20
# 可选：附件存储目录和分块大小（默认 backend/data/content/chat_attachments、1 MiB）。
# CHAT_ATTACHMENT_DIR=
# CHAT_ATTACHMENT_UPLOAD_CHUNK_SIZE_BYTES=1048576

# ===== Cookie / CORS =====
# 同源 Docker 部署通常不需要 CORS；启用 HTTPS 后必须把 COOKIE_SECURE 改为 true。
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=
