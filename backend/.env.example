# 复制本文件为 backend/.env 并填入真实值（.env 已 gitignore，不会进仓库）。
# 下方为全部可配置项；未列出的使用 src/config.py 的默认值。

# ===== 数据库（PostgreSQL，库名 cortex）=====
# 生产/部署通过环境变量注入；本地开发默认见 src/config.py。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cortex
# Docker compose 用（postgres 服务）
POSTGRES_DB=cortex
POSTGRES_USER=postgres
# compose 启动必填：留空或用 postgres 会让编排直接报错退出；生产请用强密码。
POSTGRES_PASSWORD=

# ===== LLM 对话 =====
OPENAI_API_KEY=
BASE_URL=https://api.openai.com/v1
MODEL_NAME=Qwen3.6-35B
# 可选：思考模型附加参数（JSON），如 {"reasoning_effort":"high"}
# SMART_EXTRA_BODY=

# ===== Embedding / 知识库 RAG =====
# provider: api(OpenAI 兼容远程) | local(sentence-transformers 进程内本地模型)
EMBEDDING_PROVIDER=api
# --- api 模式 ---
EMBEDDING_MODEL=Qwen3-Embedding-8B
EMBEDDING_BASE_URL=https://api.openai.com/v1
# --- local 模式 ---
EMBEDDING_LOCAL_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_LOCAL_DEVICE=cpu
# 国内加速下载 HuggingFace 模型（huggingface_hub 读 os.environ）
# HF_ENDPOINT=https://hf-mirror.com
RAG_TOP_K=3

# ===== AI 大脑（FalkorDB 认知记忆）=====
# FalkorDB 连接（本地开发默认；compose 部署由 backend environment 覆盖为 redis://falkordb:6379）
FALKORDB_URL=redis://localhost:6379
# 可选：FalkorDB 启用 ACL 认证时填写
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=
# FalkorDB graph 名（默认 cortex，与 PG 库同名）
FALKORDB_GRAPH_NAME=cortex
# AI 大脑总开关：true=启用记忆抽取/巩固/recall；false=紧急回退（对话不带认知记忆）
MEMORY_ENABLED=true
# 抽取档位：deep=Entity+Fact+Episode+Preference（默认，Fact 是时序记忆核心）；light=仅 Entity+Episode（降级）
MEMORY_EXTRACT_DEPTH=deep
# recall 参数：每次召回返回 top_k 条；图扩展最多 hops 跳（≤2）
MEMORY_RECALL_TOP_K=8
MEMORY_RECALL_HOPS=2
# 衰减：超过 memory_decay_days 未被 recall 命中的节点，定时任务降权 confidence
MEMORY_DECAY_DAYS=90
# 维护任务（衰减/孤儿对账）执行间隔（秒）
MEMORY_MAINTENANCE_INTERVAL_SECONDS=86400

# ===== 图像生成（文章封面等）=====
IMAGE_GENERATION_PROVIDER=openai
IMAGE_GENERATION_MODEL=gpt-image-1
# 硅基流动示例：provider=siliconflow、model=Kwai-Kolors/Kolors、size=1024x1024。
# IMAGE_GENERATION_BASE_URL=https://api.siliconflow.cn/v1
# IMAGE_GENERATION_API_KEY=

# ===== 安全（必填）=====
# JWT 签名密钥：缺失或使用公开弱值时服务启动即失败。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# 注册邀请码：留空关闭注册；填写后仅匹配邀请码可注册。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(24))"
REGISTRATION_INVITE_CODE=
# 用户 LLM Key 数据库加密主密钥（必填，部署后稳定保管）。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SETTINGS_ENCRYPTION_KEY=

# ===== 公开聊天（匿名入口，按 IP 共享额度）=====
PUBLIC_CHAT_DAILY_IP_LIMIT=10

# ===== AI 聊天附件 =====
# 上传硬上限 10 MiB；发送时图片 5 MiB、文档 10 MiB、最多 20 个且合计 25 MiB。
CHAT_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
CHAT_ATTACHMENT_MAX_IMAGE_SIZE_BYTES=5242880
CHAT_ATTACHMENT_MAX_DOCUMENT_SIZE_BYTES=10485760
CHAT_ATTACHMENT_MAX_COUNT_PER_MESSAGE=20
CHAT_ATTACHMENT_MAX_TOTAL_SIZE_BYTES=26214400
# 文档抽取：单文件最多 30000 字符，一条消息合计最多 80000 字符；超出明确标记截断。
CHAT_ATTACHMENT_MAX_DOCUMENT_CHARS=30000
CHAT_ATTACHMENT_MAX_TOTAL_DOCUMENT_CHARS=80000
CHAT_ATTACHMENT_PENDING_TTL_SECONDS=86400
CHAT_ATTACHMENT_CLAIM_TTL_SECONDS=7200
# 单用户 pending 草稿上限，防止持续上传占满磁盘。
CHAT_ATTACHMENT_MAX_PENDING_COUNT_PER_USER=100
CHAT_ATTACHMENT_MAX_PENDING_SIZE_BYTES_PER_USER=104857600
CHAT_ATTACHMENT_CLEANUP_BATCH_SIZE=20
# 可选：附件存储目录和分块大小（默认 backend/data/content/chat_attachments、1 MiB）。
# CHAT_ATTACHMENT_DIR=
# CHAT_ATTACHMENT_UPLOAD_CHUNK_SIZE_BYTES=1048576

# ===== 用户订阅（兑换码激活 + 平台 key + 周配额）=====
# 兑换码激活后的默认订阅时长（天）
SUBSCRIPTION_DURATION_DAYS=30
# 订阅期每周 token 额度（订阅用户用平台 .env key，按 provider 真实 usage 扣减，超额/到期回退用户 BYOK）
SUBSCRIPTION_WEEKLY_TOKEN_LIMIT=100000000
# 单次请求 input token 上限（system+历史+当前+RAG+附件，兜底防单条+附件爆炸；历史由 compact 控制）
SUBSCRIPTION_PER_REQUEST_TOKEN_LIMIT=100000
# 超级管理员：启动时自动创建账号；账号已存在时只提升权限，不覆盖原密码。两项必须同时填写。
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=

# ===== 上下文压缩 compact（同步 LLM 摘要）=====
# 上下文预算（token）；达到 预算 × COMPACT_TRIGGER_RATIO 时触发摘要压缩历史
COMPACT_CONTEXT_BUDGET=20000
COMPACT_TRIGGER_RATIO=0.7
# 压缩时保留的最近消息条数（不参与摘要，原样拼回）
COMPACT_RECENT_COUNT=12

# ===== Cookie / CORS =====
# 默认留空（注释掉）：按请求协议自动推导 secure（HTTPS / 反代 → secure，本地 HTTP → 不 secure），无需配置。
# 仅需强制覆盖时开启：true=总 secure（HTTP 下浏览器不发送，本地登录会失败）；false=总不 secure。
# COOKIE_SECURE=
COOKIE_SAMESITE=lax
CORS_ALLOW_ORIGINS=

# ===== 可观测性（Sentry / 链路追踪）=====
# Sentry DSN；留空=禁用（本地可不配）。生产建议配置以捕获未处理异常。
SENTRY_DSN=
# 事务采样率 0.0~1.0；0=不上报性能追踪，生产建议 0.1~0.3。
SENTRY_TRACES_SAMPLE_RATE=0.0
# 部署环境标识（production/staging）；空=Sentry 默认。
SENTRY_ENVIRONMENT=
