# Copy this file to the repository root as .env when overrides are needed.

# Direct HTTP access. When TLS is terminated by a host reverse proxy, bind to
# 127.0.0.1 and use a private port such as 8080 instead.
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=80

# Reproducible build toolchain versions.
PYTHON_VERSION=3.14
UV_VERSION=0.6.5
NODE_VERSION=22
NGINX_VERSION=1.28-alpine

